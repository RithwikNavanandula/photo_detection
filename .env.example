# Flask / API
FLASK_SECRET_KEY=change-me-in-production
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax

# Turso (primary app database)
TURSO_DB_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

# Scan photos on persistent disk (Render)
SCAN_PHOTOS_DIR=/var/data/scan_photos

# OTP email (Gmail app password)
GMAIL_SENDER=
GMAIL_APP_PASSWORD=

# OCR.space key used by /api/ocr
OCR_SPACE_API_KEY=

# Local-only (Docker sets this automatically)
# FLASK_ORIGIN=http://127.0.0.1:5000
