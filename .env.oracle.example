# Copy to .env on the Oracle VM:  cp .env.oracle.example .env

FLASK_SECRET_KEY=change-me-to-a-long-random-string

# Use 0 while testing on http://PUBLIC_IP:3000 (no HTTPS yet).
# Set to 1 after you put HTTPS (Caddy/Nginx + domain) in front.
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax

# Host port published by Docker (open this in OCI Security List)
HOST_PORT=3000

# Optional
# OCR_SPACE_API_KEY=
# GMAIL_SENDER=
# GMAIL_APP_PASSWORD=
# SESSION_DAYS=7
